<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
   xmlns="https://migdotdev.github.io/cse445_a4"
   targetNamespace="https://migdotdev.github.io/cse445_a4"
   elementFormDefault="qualified" attributeFormDefault="unqualified">

   <xsd:annotation>
      <xsd:documentation xml:lang="en">
         CSE 445 Assignment 4 - Schema for the directory of National Parks
      </xsd:documentation>
   </xsd:annotation>

   <!-- Root element, holds all of the national parks -->
   <xsd:element name="NationalParks" type="NationalParksType"/>

   <xsd:complexType name="NationalParksType">
      <xsd:sequence>
         <xsd:element name="NationalPark" type="NationalParkType" minOccurs="1" maxOccurs="unbounded"/>
      </xsd:sequence>
   </xsd:complexType>

   <!-- Each park has a Name, one or more Phones, and an Address (in that order) -->
   <!-- Rating is optional so some parks will not have it -->
   <xsd:complexType name="NationalParkType">
      <xsd:sequence>
         <xsd:element name="Name" type="xsd:string" minOccurs="1" maxOccurs="1"/>
         <xsd:element name="Phone" type="xsd:string" minOccurs="1" maxOccurs="unbounded"/>
         <xsd:element name="Address" type="AddressType" minOccurs="1" maxOccurs="1"/>
      </xsd:sequence>
      <xsd:attribute name="Rating" type="xsd:decimal" use="optional"/>
   </xsd:complexType>

   <!-- Address parts go Number, Street, City, State, Zip -->
   <!-- NearestAirport is required on every Address -->
   <xsd:complexType name="AddressType">
      <xsd:sequence>
         <xsd:element name="Number" type="xsd:int" minOccurs="1" maxOccurs="1"/>
         <xsd:element name="Street" type="xsd:string" minOccurs="1" maxOccurs="1"/>
         <xsd:element name="City" type="xsd:string" minOccurs="1" maxOccurs="1"/>
         <xsd:element name="State" type="xsd:string" minOccurs="1" maxOccurs="1"/>
         <!-- used string for zip so zips that start with 0 still work -->
         <xsd:element name="Zip" type="xsd:string" minOccurs="1" maxOccurs="1"/>
      </xsd:sequence>
      <xsd:attribute name="NearestAirport" type="xsd:string" use="required"/>
   </xsd:complexType>

</xsd:schema>
